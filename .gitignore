# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.env
.env.*

# Data: raw and processed data are never committed
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet
*.jsonl.gz
# Small text-free samples (< 5 MB each) are committed for tests and CI
!data/samples/*.jsonl.gz

# Kubernetes credentials
kubeconfig
kubeconfig*
*.kubeconfig
.kube/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Chat exports (handoff notes are tracked, raw transcripts are not)
docs/handoff/*.txt
# PRD PDF has personal contact details: keep PDFs in docs/ untracked, except the plan
docs/*.pdf
!docs/Skypiea_Final_Plan.pdf

# Chat exports are never committed

# The full accuracy log is committed gzipped (results/p1_accuracy.csv.gz)
results/p1_accuracy.csv

# Demo scratch (make demo) and locally built model bundles
.demo/
models/lgbm-*/
