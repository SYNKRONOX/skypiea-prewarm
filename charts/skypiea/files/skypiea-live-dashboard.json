{
 "uid": "skypiea-live",
 "title": "Skypiea Live: baseline vs predictive",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "tags": [
  "skypiea",
  "live"
 ],
 "timezone": "browser",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Added latency per call, p50 and p95 (1 min windows)",
   "description": "What the gateway added to each call (hold + cold wait + proxying), per stack. Per-call values are in the Live Console; Prometheus sees 1-minute windows.",
   "datasource": {
    "type": "prometheus",
    "uid": "skypiea-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "skypiea-prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le, namespace) (rate(skypiea_gateway_added_latency_seconds_bucket[1m])))",
     "legendFormat": "p50 {{namespace}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "skypiea-prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(skypiea_gateway_added_latency_seconds_bucket[1m])))",
     "legendFormat": "p95 {{namespace}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Cold-call rate (1 min windows)",
   "description": "Calls that found no ready pod and took the cold path, per stack.",
   "datasource": {
    "type": "prometheus",
    "uid": "skypiea-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "skypiea-prom"
     },
     "expr": "sum by (namespace) (rate(skypiea_gateway_calls_total{cold=\"true\"}[1m])) / clamp_min(sum by (namespace) (rate(skypiea_gateway_calls_total[1m])), 1e-9)",
     "legendFormat": "{{namespace}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
