      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name",
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "skypiea-prom"
     },
     "expr": "sum by (namespace) (skypiea_gateway_calls_total)",
     "legendFormat": "calls {{namespace}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "skypiea-prom"
     },
     "expr": "sum by (namespace) (skypiea_gateway_calls_total{cold=\"true\"})",
     "legendFormat": "cold {{namespace}}"
    }
   ]
  },
