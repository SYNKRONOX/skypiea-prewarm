{
  "uid": "skypiea-overview",
  "title": "Skypiea: cold starts and warm pool",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "skypiea"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cold-call rate",
      "description": "Share of tool calls that found no ready pod and took the cold path (after the 150 ms hold).",
      "datasource": {
        "type": "prometheus",
        "uid": "skypiea-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "skypiea-prom"
          },
          "expr": "sum(rate(skypiea_gateway_calls_total{cold=\"true\"}[$__rate_interval])) / clamp_min(sum(rate(skypiea_gateway_calls_total[$__rate_interval])), 1e-9)",
          "legendFormat": "cold share"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Prewarm hit rate",
      "description": "Calls that found a ready pod on arrival.",
      "datasource": {
        "type": "prometheus",
        "uid": "skypiea-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "skypiea-prom"
          },
          "expr": "sum(rate(skypiea_gateway_prewarm_hits_total[$__rate_interval])) / clamp_min(sum(rate(skypiea_gateway_prewarm_hits_total[$__rate_interval])) + sum(rate(skypiea_gateway_prewarm_misses_total[$__rate_interval])), 1e-9)",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Added latency (gateway on top of the tool)",
      "description": "Hold + cold wait + proxying.",
